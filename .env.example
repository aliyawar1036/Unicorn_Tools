# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical production URL where this application is hosted.
APP_URL="https://unicorn-tools.vercel.app/"

# VITE_CONTACT_EMAIL: The public contact support email displayed across the site
VITE_CONTACT_EMAIL="digital.future1543@gmail.com"

# Server-Side Email Delivery Configuration (Used by /api/contact)
# Configure one of the services below to enable automatic email dispatch:
# 1. Resend (https://resend.com)
RESEND_API_KEY=""
# 2. SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=""
# Target receiver email for inquiries (defaults to digital.future1543@gmail.com)
CONTACT_RECEIVER_EMAIL="digital.future1543@gmail.com"

# VITE_ADSENSE_CLIENT_ID: Optional Google AdSense Publisher ID (e.g., "ca-pub-XXXXXXXXXXXXXXXX")
# When activated with a real approved publisher ID, enables live AdSense tags in AdSlot components.
VITE_ADSENSE_CLIENT_ID=""

# VITE_GA_MEASUREMENT_ID: Optional Google Analytics 4 ID (e.g., "G-XXXXXXXXXX")
VITE_GA_MEASUREMENT_ID=""
